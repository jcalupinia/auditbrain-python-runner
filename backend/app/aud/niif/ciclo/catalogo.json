   "document": "NIIF para las PYMES, Sección 13 párr. 13.19 y Sección 27 párr. 27.2–27.4",
   "url": "https://www.ifrs.org/issued-standards/ifrs-for-smes/",
   "type": "Norma contable"
  },
  "nia": [
   {
    "document": "NIA 501",
    "section": "párr. 4–8",
    "requirement": "Si los inventarios son materiales, asistir al recuento físico y cotejar cantidades con los registros: existencia y condición."
   },
   {
    "document": "NIA 540 (Revisada)",
    "section": "párr. 13 y 17–30",
    "requirement": "El VNR es una estimación contable: evaluar el método, los datos (precios y costos) y los supuestos significativos, y el posible sesgo de la dirección."
   },
   {
    "document": "NIA 500",
    "section": "párr. 6–9",
    "requirement": "Evidencia suficiente y adecuada; evaluar la exactitud e integridad del inventario valorado que produce la entidad."
   },
   {
    "document": "NIA 330",
    "section": "párr. 18",
    "requirement": "Aplicar procedimientos sustantivos a la valoración del inventario por ser un saldo material."
   }
  ],
