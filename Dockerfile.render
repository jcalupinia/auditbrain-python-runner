# ==========================================================
# Dockerfile.render — imagen de PRODUCCIÓN del servicio auditbrain-python-runner
# en Render (render.yaml: runtime: docker, dockerfilePath: ./Dockerfile.render).
#
# Por qué Docker: el PDF ejecutivo del papel NIIF se genera con WeasyPrint, que
# necesita librerías nativas (Pango, HarfBuzz, fontconfig) que un servicio
# `env: python` de Render no puede instalar. Aquí se instalan con apt.
#
# Liviano a propósito (plan starter, sin OOM): instala requirements-prod.txt
# (NO el requirements.txt legacy con torch/transformers) + requirements-pdf.txt.
# El Dockerfile de la raíz queda para uso local.
# ==========================================================
# Base: python:3.12-slim de Docker Hub. Se puede cambiar por un espejo idéntico
# (p. ej. public.ecr.aws/docker/library/python:3.12-slim) con --build-arg.
ARG BASE_IMAGE=python:3.12-slim
FROM ${BASE_IMAGE}

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

# Librerías nativas de WeasyPrint (>= 53 ya no usa cairo) + fuentes base.
#
# libreoffice-calc: la herramienta de Nómina ("Pasivos Acumulados y Gastos de
# Nómina") recalcula las cédulas Excel ejecutando en runtime
# `soffice --headless --calc --convert-to xlsx` (backend/app/aud/niif/
# procesadores/nomina/recalc.py y nomina_beneficios.py). Sin este paquete la
# consola responde 500 FileNotFoundError: 'soffice'. Va aquí para que el binario
# sea permanente y no dependa de una instalación manual que un redeploy borra.
# --no-install-recommends mantiene la imagen razonable (crece ~350 MB; evita
# Java y extras que la conversión headless no necesita).
RUN apt-get update && apt-get install -y --no-install-recommends \
        curl \
        libpango-1.0-0 \
        libpangoft2-1.0-0 \
        libharfbuzz0b \
        libharfbuzz-subset0 \
        libfontconfig1 \
        fonts-dejavu-core \
        fonts-liberation \
        shared-mime-info \
        poppler-utils \
        libreoffice-calc \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-prod.txt requirements-pdf.txt ./
RUN pip install --upgrade pip setuptools wheel \
 && pip install -r requirements-prod.txt \
 && pip install -r requirements-pdf.txt

COPY . .

# ==========================================================
# Biblioteca Normativa NIIF (repositorio PRIVADO)
# ==========================================================
# Las normas de la IFRS Foundation y los modelos de estados financieros de EY,
# KPMG, PwC, Deloitte y Grant Thornton NO viven en este repositorio, que es
# PÚBLICO. Se traen durante el build desde `jcalupinia/herramienta-niif-18` y
# quedan dentro de la imagen, que se construye y permanece en el servidor de la
# firma. Así el despliegue no necesita ningún paso manual y el material con
# licencia restringida nunca se publica.
#
# La credencial se pasa como SECRETO DE BUILDKIT (`--mount=type=secret`), de
# modo que NO queda en las capas ni en `docker history`. Se comprobó que el
# servidor usa Docker 29.9.0 con el plugin buildx instalado, así que BuildKit
# es el constructor.
#
#   docker build --secret id=niif18_token,env=NIIF18_REPO_TOKEN ...
#
# RESPALDO: si el constructor no entrega el secreto (p. ej. una interfaz que
# solo sabe pasar build args), se usa el build arg `NIIF18_REPO_TOKEN`. Así la
# funcionalidad no queda muerta en silencio. El log del build dice SIEMPRE qué
# vía se usó ("credencial via secreto de BuildKit" o "via build arg"), para que
# se pueda comprobar sin adivinar. Con el build arg el token sí queda en
# `docker history`: use entonces un token de grano fino, de solo lectura y
# limitado a ese único repositorio.
#
# Si el token NO se pasa, el build NO falla: la imagen queda sin biblioteca y el
# módulo NIIF responde 503 con un mensaje claro. El resto de la plataforma
# arranca igual. Es la misma filosofía de aislamiento con la que se montan Forge,
# el Motor de Ingesta y el Validador SRI: una pieza opcional no tumba el servicio.
ARG NIIF18_REPO=jcalupinia/herramienta-niif-18
ARG NIIF18_REF=main
# Respaldo: SOLO se usa si el constructor no entrega el secreto. Pasarlo por
# build arg deja el token en `docker history`; por eso se prefiere el secreto.
ARG NIIF18_REPO_TOKEN=""
RUN --mount=type=secret,id=niif18_token \
    set -u; \
    if [ -s /run/secrets/niif18_token ]; then \
      NIIF_TOKEN="$(cat /run/secrets/niif18_token)"; NIIF_ORIGEN="secreto de BuildKit"; \
    else \
      NIIF_TOKEN="${NIIF18_REPO_TOKEN}"; NIIF_ORIGEN="build arg (queda en docker history)"; \
    fi; \
    if [ -n "${NIIF_TOKEN}" ]; then \
      echo "NIIF 18: trayendo la Biblioteca Normativa de ${NIIF18_REPO}@${NIIF18_REF} · credencial via ${NIIF_ORIGEN}"; \
      ( set -e; \
        mkdir -p /tmp/niif18 && cd /tmp/niif18; \
        curl -fsSL -H "Authorization: Bearer ${NIIF_TOKEN}" \
             -H "Accept: application/vnd.github+json" \
             "https://api.github.com/repos/${NIIF18_REPO}/tarball/${NIIF18_REF}" \
             -o fuente.tar.gz; \
        tar -xzf fuente.tar.gz; \
        mkdir -p /app/base-normativa; \
        cp -r */base-normativa/libro /app/base-normativa/libro; \
        cp    */base-normativa/manifiesto.json /app/base-normativa/manifiesto.json; \
      ) && \
      echo "NIIF 18: biblioteca instalada ($(find /app/base-normativa/libro -type f 2>/dev/null | wc -l) archivos)" || \
      echo "ERROR NIIF 18: no se pudo traer la biblioteca. La imagen sigue, pero el modulo respondera 503."; \
      rm -rf /tmp/niif18; \
    else \
      echo "AVISO NIIF 18: sin credencial de build (ni secreto niif18_token ni build arg); la imagen queda SIN Biblioteca Normativa y el modulo respondera 503."; \
    fi

# Commit con el que se construyó la imagen (Preview Environments: el backend se
# niega a arrancar si la etiqueta esperada no coincide con este valor). En Render
# y en builds locales sin --build-arg queda "unknown" y no cambia nada.
ARG GIT_SHA=unknown
ENV BUILD_COMMIT=${GIT_SHA}
LABEL org.opencontainers.image.revision=${GIT_SHA} \
      org.opencontainers.image.source="https://github.com/jcalupinia/auditbrain-python-runner"

# Render inyecta $PORT; 10000 por compatibilidad local.
EXPOSE 10000
CMD ["sh", "-c", "uvicorn app:app --host 0.0.0.0 --port ${PORT:-10000}"]
