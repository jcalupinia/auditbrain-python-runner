    "type": "Norma contable"
   },
   "nia": [
    {
     "document": "NIA 501",
     "section": "párr. 4–8",
     "requirement": "Si los inventarios son materiales, asistir al recuento físico y cotejar cantidades con los registros: existencia y condición."
    },
    {
     "document": "NIA 540 (Revisada)",
     "section": "párr. 13 y 17–30",
